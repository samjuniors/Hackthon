# ==============================================================================
# Thermal Decision Engine — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your real credentials.
# NEVER commit .env.local or real secrets to source control.

# FortyGuard Hyperlocal Thermal API Configuration
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=your_fortyguard_api_key_here

# Google Gemini API Configuration (Primary LLM Explainer Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Default Execution Data Source (FIXTURE = demo captured dataset, LIVE = FortyGuard API)
FORTYGUARD_DATA_SOURCE=FIXTURE

# Application Settings
NEXT_PUBLIC_APP_NAME="Thermal Decision Engine"
NEXT_PUBLIC_APP_ENV=development