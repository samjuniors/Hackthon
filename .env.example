# ==============================================================================
# Thermal Decision Engine — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or any real secrets to source control.

# FortyGuard API Configuration
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=

# LLM / AI Configuration (for explanation and interactive reasoning layer)
AI_API_KEY=

# Application Configuration
NEXT_PUBLIC_APP_NAME="Thermal Decision Engine"
NEXT_PUBLIC_APP_ENV=development
