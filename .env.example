# ==============================================================================
# Thermal Decision Engine — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and populate with your real credentials.
# NEVER commit .env.local or real secrets to source control.
#
# Server-side only: every variable below is read in API routes / server code.
# Nothing here is exposed to the browser (no NEXT_PUBLIC_ secrets).

# ─── FortyGuard Hyperlocal Thermal API ────────────────────────────────────────
# Primary provider for thermal-field data.
#   LIVE mode  → real /v1/heatmap requests (spends credits)
#   DEMO mode  → verbatim replay of the captured Lower Manhattan response
#                (tests/fixtures/heatmap_captured_demo.json — zero requests)
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com
FORTYGUARD_API_KEY=your_fortyguard_api_key_here

# Default data source at boot: FIXTURE (captured DEMO replay) or LIVE.
FORTYGUARD_DATA_SOURCE=FIXTURE

# ─── AI Explanation Providers (all optional) ─────────────────────────────────
# The decision explanation layer falls back through the configured providers
# and finally to the built-in deterministic explainer — the app works with
# NONE of these keys set.
#
# Google Gemini (primary LLM explainer)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude (secondary)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_API_KEY is accepted as an alias for ANTHROPIC_API_KEY.
# ANTHROPIC_MODEL / CLAUDE_MODEL override the default model.
# ANTHROPIC_BASE_URL overrides the API endpoint (optional).

# Z.ai (tertiary — uses the pre-configured z-ai-web-dev-sdk server-side; no
# key in code, the SDK reads its own environment credentials).
# ZAI_MODEL=glm-4.6

# Generic single-key fallbacks (classified by key format heuristics):
# AI_API_KEY=...
# AI_PROVIDER=gemini | claude

# ─── Database (Prisma / SQLite) ───────────────────────────────────────────────
DATABASE_URL="file:./db/custom.db"

# ─── Application Settings ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Thermal Decision Engine"
NEXT_PUBLIC_APP_ENV=development

# ─── Basemap Configuration ────────────────────────────────────────────────────
# NO API KEY REQUIRED. The map basemap uses Esri World Gray Canvas raster tiles
# (server.arcgisonline.com), which are keyless and watermark-free.
#
# History: the previous CARTO basemap (basemaps.cartocdn.com) began baking an
# "API KEY REQUIRED" watermark into keyless tiles (see carto.com/basemaps/apikey).
# If you ever want to restore CARTO imagery, register at carto.com/basemaps/apikey
# and add a browser-safe public token as:
#   NEXT_PUBLIC_CARTO_BASEMAP_KEY=your_carto_public_basemap_token
# (Never commit real tokens to source control. The current Esri basemap
#  requires no key and is the production default.)
